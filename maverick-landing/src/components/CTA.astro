---
import { Rocket, Github } from "lucide-astro";
---

<section id="get-started" class="py-36 relative overflow-hidden">
    <!-- Glowing background -->
    <div class="absolute inset-0 -z-10">
        <div
            class="absolute inset-0 bg-gradient-to-t from-indigo-950/30 via-gray-950 to-gray-950"
        >
        </div>
        <div
            class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-indigo-600/15 rounded-full blur-[120px] glow-orb"
        >
        </div>
        <div
            class="absolute bottom-[10%] left-[20%] w-[300px] h-[300px] bg-purple-600/10 rounded-full blur-[100px] glow-orb-delayed"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 text-center z-10 relative">
        <div class="reveal-scale">
            <h2
                class="text-4xl sm:text-5xl md:text-7xl font-black mb-8 tracking-tight"
            >
                Ready to code <span class="text-gradient">faster</span>?
            </h2>
            <p
                class="text-lg md:text-xl text-gray-400 mb-14 max-w-2xl mx-auto leading-relaxed"
            >
                Install Maverick today and experience AI-powered development in
                your terminal.
            </p>

            <div
                class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12"
            >
                <a
                    href="https://www.npmjs.com/package/maverick-ai-cli"
                    target="_blank"
                    class="group glow-button px-10 py-5 rounded-xl bg-white text-gray-950 font-bold text-base hover:bg-gray-100 transition-all duration-300 flex items-center gap-2.5 shadow-[0_0_60px_-10px_rgba(255,255,255,0.3)]"
                >
                    <Rocket class="w-5 h-5" />
                    Start Using Maverick
                </a>

                <a
                    href="https://github.com/CodeMaverick-143/maverick-cli"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-10 py-5 rounded-xl bg-white/[0.04] text-white font-semibold text-base hover:bg-white/[0.08] transition-all duration-300 border border-white/10 hover:border-white/20 flex items-center gap-2.5"
                >
                    <Github class="w-5 h-5" />
                    Star on GitHub
                </a>
            </div>

            <!-- Install command -->
            <div
                class="inline-flex items-center gap-3 px-6 py-3 rounded-lg bg-gray-900/60 border border-white/10 text-sm font-mono text-gray-300 shimmer-border"
            >
                <span class="text-indigo-400">$</span>
                <span>npm install -g maverick-ai-cli</span>
            </div>
        </div>
    </div>
</section>
