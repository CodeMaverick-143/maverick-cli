---
import { BrainCircuit, CircuitBoard, GitMerge, Bot } from "lucide-astro";

const capabilities = [
    {
        icon: Bot,
        title: "Autonomous Execution",
        description:
            "Give a goal, and Maverick handles the rest — planning, executing, and verifying.",
        color: "text-indigo-400",
        bg: "bg-indigo-500/10",
    },
    {
        icon: CircuitBoard,
        title: "Tool Chaining",
        description:
            "Intelligently combines CLI tools, APIs, and file operations to solve complex problems.",
        color: "text-purple-400",
        bg: "bg-purple-500/10",
    },
    {
        icon: BrainCircuit,
        title: "Long-term Memory",
        description:
            "Remembers context across sessions, projects, and conversations.",
        color: "text-cyan-400",
        bg: "bg-cyan-500/10",
    },
    {
        icon: GitMerge,
        title: "Strategic Planning",
        description:
            "Breaks down requests into actionable steps with dependency awareness.",
        color: "text-emerald-400",
        bg: "bg-emerald-500/10",
    },
];
---

<section id="agentic" class="py-28 relative overflow-hidden">
    <!-- Background -->
    <div
        class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-indigo-950/10 to-transparent pointer-events-none"
    >
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-16">
            <!-- Left: Content -->
            <div class="lg:w-1/2 reveal-left">
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-sm text-amber-400 mb-6"
                >
                    <span class="relative flex h-2 w-2">
                        <span
                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"
                        ></span>
                        <span
                            class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"
                        ></span>
                    </span>
                    Coming Soon
                </div>
                <h2 class="text-4xl md:text-5xl font-bold mb-4 tracking-tight">
                    Agentic Mode
                </h2>
                <p class="text-lg text-gray-500 mb-8 font-medium">
                    Autonomous. Intelligent. Capable.
                </p>
                <p class="text-gray-400 text-lg mb-10 leading-relaxed">
                    The future of development is agentic. Maverick will plan,
                    execute, and self-correct complex multi-step tasks —
                    completely autonomously.
                </p>

                <div class="grid sm:grid-cols-2 gap-4">
                    {
                        capabilities.map((cap, i) => (
                            <div
                                class="glass-card p-5 rounded-xl reveal"
                                style={`transition-delay: ${i * 0.08}s`}
                            >
                                <div
                                    class={`${cap.bg} ${cap.color} w-10 h-10 rounded-lg flex items-center justify-center mb-3`}
                                >
                                    <cap.icon class="w-5 h-5" />
                                </div>
                                <h4 class="font-semibold text-white mb-1 text-sm">
                                    {cap.title}
                                </h4>
                                <p class="text-xs text-gray-400 leading-relaxed">
                                    {cap.description}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Right: Agent Demo -->
            <div class="lg:w-1/2 reveal-right">
                <div class="relative">
                    <!-- Glow -->
                    <div
                        class="absolute -inset-4 bg-gradient-to-r from-indigo-500/10 via-purple-500/5 to-amber-500/5 rounded-2xl blur-xl"
                    >
                    </div>

                    <div
                        class="relative rounded-xl terminal-window bg-[#0a0a0f] border border-white/[0.08] overflow-hidden"
                    >
                        <!-- Title Bar -->
                        <div
                            class="flex items-center gap-2 px-4 py-3 border-b border-white/5 bg-white/[0.02]"
                        >
                            <div class="flex gap-2">
                                <div class="w-3 h-3 rounded-full bg-[#ff5f57]">
                                </div>
                                <div class="w-3 h-3 rounded-full bg-[#febc2e]">
                                </div>
                                <div class="w-3 h-3 rounded-full bg-[#28c840]">
                                </div>
                            </div>
                            <div class="ml-4 text-xs text-gray-500 font-mono">
                                maverick agent
                            </div>
                        </div>
                        <!-- Content -->
                        <div
                            class="p-6 space-y-5 font-mono text-sm"
                            style="font-family: 'JetBrains Mono', monospace;"
                        >
                            <div class="flex items-start gap-3 opacity-60">
                                <div
                                    class="text-gray-500 text-xs font-bold min-w-10 pt-0.5"
                                >
                                    USER
                                </div>
                                <div class="text-gray-300 leading-relaxed">
                                    "Refactor the auth flow to use JWTs and add
                                    Google OAuth."
                                </div>
                            </div>

                            <div class="flex items-start gap-3">
                                <div
                                    class="text-indigo-400 text-xs font-bold min-w-10 pt-0.5"
                                >
                                    PLAN
                                </div>
                                <div class="space-y-2.5 text-gray-400 flex-1">
                                    <div class="text-indigo-300 mb-2">
                                        Breaking this into 3 phases:
                                    </div>
                                    <div class="flex items-center gap-2.5">
                                        <span class="text-emerald-400 text-base"
                                            >✓</span
                                        >
                                        <span
                                            >Install passport-google-oauth20</span
                                        >
                                    </div>
                                    <div class="flex items-center gap-2.5">
                                        <span
                                            class="text-amber-400 animate-pulse text-base"
                                            >⟳</span
                                        >
                                        <span
                                            >Update User schema for provider ID</span
                                        >
                                    </div>
                                    <div
                                        class="flex items-center gap-2.5 opacity-40"
                                    >
                                        <span class="text-gray-600">○</span>
                                        <span>Create new auth routes</span>
                                    </div>
                                </div>
                            </div>

                            <div
                                class="flex items-start gap-3 pt-4 border-t border-white/5"
                            >
                                <div
                                    class="text-emerald-400 text-xs font-bold min-w-10 pt-0.5"
                                >
                                    EXEC
                                </div>
                                <div
                                    class="bg-black/40 p-3 rounded-lg border border-white/5 w-full text-gray-300"
                                >
                                    &gt; npm install passport
                                    passport-google-oauth20<br />
                                    <span class="text-gray-500"
                                        >added 2 packages in 1.2s</span
                                    >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
