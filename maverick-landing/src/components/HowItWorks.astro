---
import CodeBlock from "./CodeBlock.astro";
import { Download, TerminalSquare, Sparkles } from "lucide-astro";

const steps = [
    {
        icon: Download,
        number: "01",
        title: "Install the CLI",
        description: "One command to install Maverick globally. Works on macOS, Linux, and Windows.",
        code: "npm install -g maverick-ai-cli",
    },
    {
        icon: TerminalSquare,
        number: "02",
        title: "Authenticate",
        description: "Secure device-flow authentication via GitHub. Your credentials stay local.",
        code: "maverick login",
    },
    {
        icon: Sparkles,
        number: "03",
        title: "Start Building",
        description: "Chat with AI, analyze code, and automate tasks — all from your terminal.",
        code: "maverick wakeup",
    },
];
---

<section id="how-it-works" class="py-28 relative overflow-hidden">
    <!-- Background glow -->
    <div class="absolute top-1/2 left-[-10%] -translate-y-1/2 w-[500px] h-[500px] bg-purple-600/8 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-0 right-[-5%] w-[400px] h-[400px] bg-indigo-600/8 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center max-w-2xl mx-auto mb-20 reveal">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-purple-300 mb-6 uppercase tracking-widest">
                Quick Start
            </div>
            <h2 class="text-4xl md:text-5xl font-bold mb-5 tracking-tight">
                Up and Running in <span class="text-gradient">60 Seconds</span>
            </h2>
            <p class="text-lg text-gray-400 leading-relaxed">
                No complex configuration. No signup walls. Just install and go.
            </p>
        </div>

        <!-- Steps -->
        <div class="max-w-3xl mx-auto space-y-8">
            {steps.map((step, index) => (
                <div class="reveal flex gap-6 group" style={`transition-delay: ${index * 0.1}s`}>
                    <!-- Step Number & Line -->
                    <div class="flex flex-col items-center">
                        <div class="w-14 h-14 rounded-2xl bg-white/[0.04] border border-white/10 flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500 group-hover:text-white group-hover:border-indigo-500 group-hover:scale-110 transition-all duration-400 shadow-lg group-hover:shadow-indigo-500/20">
                            <step.icon class="w-6 h-6" />
                        </div>
                        {index < steps.length - 1 && (
                            <div class="w-px h-full bg-gradient-to-b from-white/10 to-transparent mt-3 min-h-[40px]"></div>
                        )}
                    </div>

                    <!-- Content -->
                    <div class="flex-1 pb-8">
                        <div class="flex items-center gap-3 mb-2">
                            <span class="text-xs font-mono text-indigo-400/60">{step.number}</span>
                            <h3 class="text-xl font-bold text-white tracking-tight">
                                {step.title}
                            </h3>
                        </div>
                        <p class="text-gray-400 mb-4 leading-relaxed">
                            {step.description}
                        </p>
                        <CodeBlock code={step.code} title="terminal" />
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
