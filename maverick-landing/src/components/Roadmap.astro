---
import { Github, MessageCircle, Twitter } from "lucide-astro";

const links = [
    {
        href: "https://github.com/CodeMaverick-143/maverick-cli",
        icon: Github,
        name: "GitHub",
        description: "Star the repo, report issues, and contribute.",
        color: "group-hover:bg-white/20",
        iconBg: "bg-white/10",
        iconColor: "text-white",
    },
    {
        href: "#",
        icon: MessageCircle,
        name: "Discord",
        description: "Join the community, share workflows, and get help.",
        color: "group-hover:bg-[#5865F2]/30",
        iconBg: "bg-[#5865F2]/20",
        iconColor: "text-[#5865F2]",
    },
    {
        href: "#",
        icon: Twitter,
        name: "Twitter",
        description: "Follow for updates, tips, and announcements.",
        color: "group-hover:bg-[#1DA1F2]/30",
        iconBg: "bg-[#1DA1F2]/20",
        iconColor: "text-[#1DA1F2]",
    },
];
---

<section id="community" class="py-28 relative">
    <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-gray-900/30 to-transparent pointer-events-none"
    >
    </div>

    <div class="container mx-auto px-6 text-center relative z-10">
        <div class="max-w-3xl mx-auto reveal">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-emerald-300 mb-6 uppercase tracking-widest"
            >
                Community
            </div>
            <h2 class="text-4xl md:text-5xl font-bold mb-5 tracking-tight">
                Open Source & <span class="text-gradient">Community Driven</span
                >
            </h2>
            <p class="text-lg text-gray-400 mb-14 leading-relaxed">
                Built for developers, by developers. Join us to shape the future
                of AI-powered coding.
            </p>

            <div class="grid md:grid-cols-3 gap-5 stagger-children">
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="glass-card p-8 rounded-2xl group cursor-pointer reveal text-center"
                        >
                            <div
                                class={`w-14 h-14 rounded-2xl ${link.iconBg} flex items-center justify-center mx-auto mb-5 ${link.color} transition-all duration-300 group-hover:scale-110`}
                            >
                                <link.icon
                                    class={`w-6 h-6 ${link.iconColor}`}
                                />
                            </div>
                            <h3 class="text-lg font-bold mb-2">{link.name}</h3>
                            <p class="text-gray-400 text-sm leading-relaxed">
                                {link.description}
                            </p>
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</section>
