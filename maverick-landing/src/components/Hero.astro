---
import { ArrowRight, Github } from "lucide-astro";
---

<section class="relative pt-40 pb-28 overflow-hidden">
    <!-- Animated Background Orbs -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div
            class="absolute top-[-20%] left-[10%] w-[600px] h-[600px] bg-indigo-600/15 rounded-full glow-orb"
        >
        </div>
        <div
            class="absolute top-[5%] right-[5%] w-[500px] h-[500px] bg-purple-600/15 rounded-full glow-orb-delayed"
        >
        </div>
        <div
            class="absolute bottom-[-10%] left-[40%] w-[400px] h-[400px] bg-cyan-500/10 rounded-full glow-orb"
        >
        </div>
    </div>

    <!-- Grid Pattern Overlay -->
    <div
        class="absolute inset-0 opacity-[0.02]"
        style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;)"
    >
    </div>

    <div class="container mx-auto px-6 relative z-10 text-center">
        <!-- Badge -->
        <div
            class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/[0.04] border border-white/10 text-sm text-indigo-300 mb-10 shimmer-border animate-fade-in-up"
        >
            <span class="relative flex h-2 w-2">
                <span
                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"
                ></span>
                <span
                    class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"
                ></span>
            </span>
            Agentic Mode coming soon
        </div>

        <!-- Heading -->
        <h1
            class="text-5xl sm:text-6xl md:text-8xl font-black tracking-tight mb-8 animate-fade-in-up delay-100"
        >
            <span class="text-white block">Your AI</span>
            <span class="text-gradient block mt-2">Terminal Companion</span>
        </h1>

        <p
            class="text-lg md:text-xl text-gray-400 max-w-2xl mx-auto mb-12 leading-relaxed animate-fade-in-up delay-200"
        >
            Chat with AI, automate workflows, and build faster — all from your
            command line. Powered by <span class="text-indigo-400 font-medium"
                >Gemini AI</span
            >.
        </p>

        <!-- CTA Buttons -->
        <div
            class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-6 animate-fade-in-up delay-300"
        >
            <a
                href="#get-started"
                class="group glow-button px-8 py-4 rounded-xl bg-white text-gray-950 font-bold text-base hover:bg-gray-100 transition-all duration-300 flex items-center gap-2.5 shadow-[0_0_40px_-10px_rgba(255,255,255,0.3)]"
            >
                Get Started Free
                <ArrowRight
                    class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200"
                />
            </a>

            <a
                href="https://github.com/CodeMaverick-143/maverick-cli"
                target="_blank"
                rel="noopener noreferrer"
                class="group px-8 py-4 rounded-xl bg-white/[0.04] text-white font-semibold text-base hover:bg-white/[0.08] transition-all duration-300 border border-white/10 hover:border-white/20 flex items-center gap-2.5"
            >
                <Github class="w-5 h-5" />
                View on GitHub
            </a>
        </div>

        <!-- Install command -->
        <div class="animate-fade-in-up delay-400">
            <div
                class="inline-flex items-center gap-3 px-5 py-2.5 rounded-lg bg-gray-900/80 border border-white/10 text-sm font-mono text-gray-300"
            >
                <span class="text-gray-500">$</span>
                <span>npm install -g maverick-ai-cli</span>
                <button
                    class="text-gray-500 hover:text-indigo-400 transition-colors"
                    onclick="navigator.clipboard.writeText('npm install -g maverick-ai-cli')"
                    title="Copy to clipboard"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"
                        ></rect>
                        <path
                            d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                        ></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Terminal Preview -->
        <div
            class="mt-20 relative mx-auto max-w-4xl animate-scale-in delay-500"
        >
            <!-- Terminal Glow Background -->
            <div
                class="absolute -inset-4 bg-gradient-to-r from-indigo-500/10 via-purple-500/10 to-cyan-500/10 rounded-2xl blur-xl opacity-60"
            >
            </div>

            <div
                class="relative rounded-xl terminal-window bg-[#0a0a0f] border border-white/[0.08] overflow-hidden"
            >
                <!-- Title Bar -->
                <div
                    class="flex items-center gap-2 px-4 py-3 border-b border-white/5 bg-white/[0.02]"
                >
                    <div class="flex gap-2">
                        <div class="w-3 h-3 rounded-full bg-[#ff5f57]"></div>
                        <div class="w-3 h-3 rounded-full bg-[#febc2e]"></div>
                        <div class="w-3 h-3 rounded-full bg-[#28c840]"></div>
                    </div>
                    <div
                        class="ml-4 text-xs text-gray-500 font-mono flex-1 text-center"
                    >
                        maverick — zsh
                    </div>
                </div>
                <!-- Content -->
                <div
                    class="p-6 font-mono text-sm text-left leading-relaxed"
                    style="font-family: 'JetBrains Mono', monospace;"
                >
                    <div class="flex gap-2 mb-3">
                        <span class="text-green-400">➜</span>
                        <span class="text-blue-400">~/project</span>
                        <span class="text-white typing-effect"
                            >maverick wakeup</span
                        >
                    </div>
                    <div class="text-gray-300 space-y-2 mt-4">
                        <div class="text-purple-400 text-base mb-3">
                            ███╗ ███╗ █████╗ ██╗ ██╗███████╗
                        </div>
                        <div class="flex gap-2 items-center">
                            <span class="text-green-400">✔</span>
                            <span
                                >Welcome back, <span class="text-indigo-400"
                                    >Arpit</span
                                >!</span
                            >
                        </div>
                        <div class="flex gap-2 items-center mt-2">
                            <span class="text-gray-500">│</span>
                        </div>
                        <div class="flex gap-2 items-center">
                            <span class="text-cyan-400">◆</span>
                            <span class="text-gray-300">Select an option:</span>
                        </div>
                        <div class="pl-6 space-y-1 text-gray-400">
                            <div
                                class="text-white bg-white/5 px-3 py-1 rounded"
                            >
                                ● Chat <span class="text-gray-500"
                                    >— Simple chat with AI</span>
                            </div>
                            <div class="px-3 py-1">
                                ○ Tool Calling <span class="text-gray-500"
                                    >— Google Search, Code Execution</span>
                            </div>
                            <div class="px-3 py-1">
                                ○ Agent <span class="text-gray-500"
                                    >— Advanced AI agent</span>
                            </div>
                        </div>
                        <div class="flex gap-2 items-center mt-3 animate-pulse">
                            <span class="w-2 h-5 bg-indigo-400/80 inline-block"
                            ></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
