---
import { Zap, Terminal, Globe, Cpu, Bot, Workflow } from "lucide-astro";

const features = [
    {
        name: "AI Chat",
        status: "Available",
        icon: Zap,
        description:
            "Context-aware conversations powered by Gemini. Ask questions, get code suggestions, and debug — all in your terminal.",
        color: "indigo",
    },
    {
        name: "CLI-First",
        status: "Available",
        icon: Terminal,
        description:
            "No browser required. Install globally and start chatting with AI instantly from any directory.",
        color: "cyan",
    },
    {
        name: "Web Dashboard",
        status: "Available",
        icon: Globe,
        description:
            "Manage your sessions, view chat history, and configure settings through a clean web interface.",
        color: "purple",
    },
    {
        name: "Tool Integrations",
        status: "Available",
        icon: Cpu,
        description:
            "Google Search, code execution, and URL analysis — the AI can use real tools to give better answers.",
        color: "emerald",
    },
    {
        name: "Agentic Mode",
        status: "Coming Soon",
        icon: Bot,
        description:
            "Autonomous task execution. Give a goal, and Maverick plans, executes, and self-corrects until it's done.",
        color: "amber",
    },
    {
        name: "Workflow Automation",
        status: "Coming Soon",
        icon: Workflow,
        description:
            "Chain tools together to automate complex, multi-step workflows across your entire development stack.",
        color: "rose",
    },
];

const colorMap: Record<string, { icon: string; bg: string; border: string }> = {
    indigo: {
        icon: "text-indigo-400",
        bg: "bg-indigo-500/10",
        border: "group-hover:border-indigo-500/30",
    },
    cyan: {
        icon: "text-cyan-400",
        bg: "bg-cyan-500/10",
        border: "group-hover:border-cyan-500/30",
    },
    purple: {
        icon: "text-purple-400",
        bg: "bg-purple-500/10",
        border: "group-hover:border-purple-500/30",
    },
    emerald: {
        icon: "text-emerald-400",
        bg: "bg-emerald-500/10",
        border: "group-hover:border-emerald-500/30",
    },
    amber: {
        icon: "text-amber-400",
        bg: "bg-amber-500/10",
        border: "group-hover:border-amber-500/30",
    },
    rose: {
        icon: "text-rose-400",
        bg: "bg-rose-500/10",
        border: "group-hover:border-rose-500/30",
    },
};
---

<section id="features" class="py-28 relative">
    <!-- Background subtle gradient -->
    <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-indigo-950/5 to-transparent pointer-events-none"
    >
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center max-w-2xl mx-auto mb-20 reveal">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-indigo-300 mb-6 uppercase tracking-widest"
            >
                Capabilities
            </div>
            <h2 class="text-4xl md:text-5xl font-bold mb-5 tracking-tight">
                Everything You Need
            </h2>
            <p class="text-lg text-gray-400 leading-relaxed">
                A comprehensive AI toolkit designed for developers who live in
                the terminal.
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 stagger-children">
            {
                features.map((feature) => {
                    const colors = colorMap[feature.color];
                    return (
                        <div
                            class={`group glass-card p-7 rounded-2xl cursor-default reveal ${colors.border}`}
                        >
                            <div class="flex items-start justify-between mb-5">
                                <div
                                    class={`p-3 rounded-xl ${colors.bg} ${colors.icon} transition-all duration-300 group-hover:scale-110`}
                                >
                                    <feature.icon class="w-6 h-6" />
                                </div>
                                <span
                                    class:list={[
                                        "text-xs font-medium px-2.5 py-1 rounded-full border",
                                        feature.status === "Available"
                                            ? "bg-emerald-500/10 text-emerald-400 border-emerald-500/20"
                                            : "bg-amber-500/10 text-amber-400 border-amber-500/20",
                                    ]}
                                >
                                    {feature.status}
                                </span>
                            </div>
                            <h3 class="text-xl font-bold mb-2 text-white tracking-tight">
                                {feature.name}
                            </h3>
                            <p class="text-gray-400 leading-relaxed text-sm">
                                {feature.description}
                            </p>
                        </div>
                    );
                })
            }
        </div>
    </div>
</section>
