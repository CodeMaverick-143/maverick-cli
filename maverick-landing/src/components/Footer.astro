---
const currentYear = new Date().getFullYear();

const productLinks = [
    { name: "Features", href: "#features" },
    { name: "How It Works", href: "#how-it-works" },
    { name: "Agentic Mode", href: "#agentic" },
    {
        name: "npm Package",
        href: "https://www.npmjs.com/package/maverick-ai-cli",
    },
];

const resourceLinks = [
    {
        name: "GitHub",
        href: "https://github.com/CodeMaverick-143/maverick-cli",
    },
    { name: "Documentation", href: "#" },
    { name: "Community", href: "#community" },
    { name: "Changelog", href: "#" },
];

const legalLinks = [
    { name: "Privacy Policy", href: "#" },
    { name: "Terms of Service", href: "#" },
    {
        name: "MIT License",
        href: "https://github.com/CodeMaverick-143/maverick-cli/blob/main/LICENSE",
    },
];
---

<footer
    class="py-16 border-t border-white/[0.06] bg-gray-950 text-sm relative z-10"
>
    <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-4 gap-12 mb-14">
            <!-- Brand -->
            <div class="col-span-1">
                <a href="/" class="flex items-center gap-3 mb-5 group">
                    <img
                        src="/logo.jpg"
                        alt="Maverick"
                        class="w-9 h-9 rounded-lg group-hover:scale-110 transition-transform duration-300"
                    />
                    <span class="font-bold text-xl tracking-tight"
                        >Maverick</span
                    >
                </a>
                <p class="text-gray-500 leading-relaxed mb-5">
                    AI-powered CLI companion for the next generation of
                    developers.
                </p>
                <div class="flex gap-3">
                    <a
                        href="https://github.com/CodeMaverick-143/maverick-cli"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 hover:border-white/20 transition-all duration-200"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                            ></path></svg
                        >
                    </a>
                    <a
                        href="#"
                        class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 hover:border-white/20 transition-all duration-200"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
                            ></path></svg
                        >
                    </a>
                </div>
            </div>

            <!-- Product -->
            <div>
                <h4 class="font-bold mb-5 text-white">Product</h4>
                <ul class="space-y-3">
                    {
                        productLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="text-gray-500 hover:text-indigo-400 transition-colors duration-200"
                                >
                                    {link.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Resources -->
            <div>
                <h4 class="font-bold mb-5 text-white">Resources</h4>
                <ul class="space-y-3">
                    {
                        resourceLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="text-gray-500 hover:text-indigo-400 transition-colors duration-200"
                                    target={
                                        link.href.startsWith("http")
                                            ? "_blank"
                                            : undefined
                                    }
                                >
                                    {link.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Legal -->
            <div>
                <h4 class="font-bold mb-5 text-white">Legal</h4>
                <ul class="space-y-3">
                    {
                        legalLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="text-gray-500 hover:text-indigo-400 transition-colors duration-200"
                                    target={
                                        link.href.startsWith("http")
                                            ? "_blank"
                                            : undefined
                                    }
                                >
                                    {link.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <div
            class="pt-8 border-t border-white/[0.06] flex flex-col md:flex-row justify-between items-center gap-4 text-gray-600"
        >
            <div>
                &copy; {currentYear} Maverick AI. Built with ❤️ by <a
                    href="https://github.com/CodeMaverick-143"
                    target="_blank"
                    class="text-gray-400 hover:text-indigo-400 transition-colors"
                    >CodeMaverick-143</a
                >
            </div>
            <div class="text-gray-600">Powered by Gemini AI</div>
        </div>
    </div>
</footer>
